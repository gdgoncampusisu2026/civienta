{
  "name": "civienta",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-civienta --only auth,firestore",
    "seed": "node firebase/seed.mjs",
    "test:rules": "firebase emulators:exec --config firebase/firebase.json --project demo-civienta --only firestore \"node --test firebase/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.37.0"
  }
}
